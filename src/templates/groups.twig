{% import '_includes/forms' as forms %}

{% set fieldLayouts = craft.app.fields.getAllLayouts() %}
{% set options = [] %}

{% for group in fieldLayouts %}

{% if 'Order' in group.type %}
    {% set options = options|merge([{ label: 'Commerce Orders', value: group.id }]) %}
{% endif %}

{% endfor %}

{{ forms.selectField({
    label: 'Custom Field Layout'|t('feed-me'),
    id: 'elementGroup-' ~ elementType,
    name: 'elementGroup[' ~ elementType ~ ']',
    options: options,
    value: 'craft\commerce\elements\Order',
    errors: feed.getErrors('elementGroup'),
    required: true,
}) }}
