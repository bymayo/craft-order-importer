{% set orderStatusOptions = [] %}
{% for orderStatus in craft.commerce.orderStatuses.allOrderStatuses %}
    {% set orderStatusOptions = orderStatusOptions | merge([{ label: orderStatus.name, value: orderStatus.id }]) %}
{% endfor %}

{% set orderFields = [   
    {
        name: 'Customer ID',
        handle: 'customerId',
        required: true,
        instructions: 'If no customer ID is provided, a new customer will be created from the "Order Email Address" field.'|t('feed-me'),
        default: {
            type: 'text',
        }
    },
    {
        name: 'Order Email Address',
        handle: 'email',
        required: true,
        default: false,
    },
    {
        name: 'Order Status',
        handle: 'orderStatusId',
        required: true,
        instructions: 'Accepts handle or ID.'|t('feed-me'),
        default: {
            type: 'select',
            options: orderStatusOptions|sort((a, b) => a.label <=> b.label)
        }
